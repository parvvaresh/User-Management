# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (SQLite for development)
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3

# For PostgreSQL (production):
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=user_management
# DJANGO_DB_USER=postgres
# DJANGO_DB_PASSWORD=your-password
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

# SMS Configuration
# Provider options: mock (development), twilio, kavenegar
SMS_PROVIDER=mock
SMS_API_KEY=your-api-key-here
SMS_SENDER_ID=UserManagement

# Twilio Configuration (if using Twilio)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+1234567890

# Kavenegar Configuration (if using Kavenegar for Iran)
# KAVENEGAR_API_KEY=your-kavenegar-api-key
